{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventEnvelope",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "default": 1
    },
    "event": {
      "type": "string"
    },
    "timestamp": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "data": {
      "$ref": "#/definitions/EventPayload"
    }
  },
  "required": ["schema_version", "event", "timestamp", "source", "data"],
  "definitions": {
    "EventPayload": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": { "const": "UserInput" },
            "text": { "type": "string" },
            "context": { "type": "object" },
            "session_id": { "type": "string" }
          },
          "required": ["type", "text", "context"]
        },
        {
          "properties": {
            "type": { "const": "ToolRequest" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "args": { "type": "object" },
            "danger_tier": { "type": "string" }
          },
          "required": ["type", "task_id", "tool_name", "args"]
        },
        {
          "properties": {
            "type": { "const": "ToolResult" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "result": { "type": "object" }
          },
          "required": ["type", "task_id", "tool_name", "result"]
        },
        {
          "properties": {
            "type": { "const": "ToolRejected" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["type", "task_id", "tool_name", "reason"]
        },
        {
          "properties": {
            "type": { "const": "ToolConfirmationRequired" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "args": { "type": "object" },
            "pending_id": { "type": "string" }
          },
          "required": ["type", "task_id", "tool_name", "args", "pending_id"]
        },
        {
          "properties": {
            "type": { "const": "ToolConfirmed" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "pending_id": { "type": "string" }
          },
          "required": ["type", "task_id", "tool_name", "pending_id"]
        },
        {
          "properties": {
            "type": { "const": "ToolDenied" },
            "task_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "pending_id": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["type", "task_id", "tool_name", "pending_id", "reason"]
        },
        {
          "properties": {
            "type": { "const": "IntentContracted" },
            "contract": {
              "type": "object",
              "properties": {
                "objective": { "type": "string" },
                "constraints": { "type": "array", "items": { "type": "string" } },
                "requires_tools": { "type": "boolean" },
                "requires_confirmation": { "type": "boolean" },
                "persistence_policy": { "type": "string" },
                "expected_output_type": { "type": "string" }
              },
              "required": ["objective", "constraints", "requires_tools", "requires_confirmation", "persistence_policy", "expected_output_type"]
            }
          },
          "required": ["type", "contract"]
        },
        {
          "properties": {
            "type": { "const": "ExecutionContextCaptured" },
            "context_id": { "type": "string" },
            "session_id": { "type": "string" },
            "task_id": { "type": "string" },
            "model_id": { "type": "string" },
            "temperature": { "type": "number" },
            "max_tokens": { "type": "integer" },
            "prompt_template_version": { "type": "string" },
            "tool_registry_version": { "type": "string" },
            "planner_version": { "type": "string" },
            "routing_decision": { "type": "string" },
            "retrieved_memory_ids": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type", "context_id", "session_id", "task_id"]
        },
        {
          "properties": {
            "type": { "const": "UiOutput" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "properties": {
            "type": { "const": "ContextUpdated" },
            "data": { "type": "object" }
          },
          "required": ["type", "data"]
        },
        {
          "properties": {
            "type": { "const": "SystemSuspend" },
            "reason": { "type": "string" }
          },
          "required": ["type", "reason"]
        },
        {
          "properties": {
            "type": { "const": "SystemResume" }
          },
          "required": ["type"]
        }
      ]
    }
  }
}
